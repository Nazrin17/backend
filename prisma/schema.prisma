generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
  appointments Appointment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  doctors   Doctor[]
  createdAt DateTime @default(now())
}

model Doctor {
  id            String    @id @default(cuid())
  name          String
  specialization String
  photoUrl      String?
  experienceYrs Int       @default(0)
  patientsCount Int       @default(0)
  feeCents      Int       @default(0)
  ratingAverage Float     @default(0)
  ratingCount   Int       @default(0)
  distanceM     Int?      // for sample data only
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  availableSlots String? // JSON array of available time slots, e.g. ["09:00", "10:00", "11:00"]
  reviews       Review[]
  appointments  Appointment[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model Appointment {
  id         String   @id @default(cuid())
  date       DateTime
  notes      String?
  gender     String?
  birthDate  DateTime?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  status     String   @default("booked")
  createdAt  DateTime @default(now())
}
